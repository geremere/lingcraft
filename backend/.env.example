# App
APP_ENV=development
HTTP_PORT=8080

# Local PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=lingraft_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# Optional admin credentials used for DB/bootstrap operations.
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=postgres

# If true, setup script tries to run docker compose automatically.
AUTO_DOCKER_UP=true
